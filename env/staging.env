# Configuracao do ambiente de STAGING (homologacao).
# Nao coloque segredos aqui: JWT_SECRET, MONGO_PASSWORD e GEMINI_API_KEY vem dos secrets do GitHub.
COMPOSE_PROJECT_NAME=inovagab-staging
APP_AMBIENTE=staging
SPRING_PROFILES_ACTIVE=staging
APP_PORT=8081
MONGO_USER=inovagab
MONGO_DATABASE=inovagab_staging
SEED_ENABLED=true
JAVA_OPTS=-XX:MaxRAMPercentage=60.0
