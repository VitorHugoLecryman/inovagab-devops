# Configuracao do ambiente de PRODUCAO.
# Nao coloque segredos aqui: JWT_SECRET, MONGO_PASSWORD e GEMINI_API_KEY vem dos secrets do GitHub.
COMPOSE_PROJECT_NAME=inovagab-production
APP_AMBIENTE=production
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8082
MONGO_USER=inovagab
MONGO_DATABASE=inovagab
# mantido ligado para a demonstracao (cria os usuarios de teste); em producao real ficaria false
SEED_ENABLED=true
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
