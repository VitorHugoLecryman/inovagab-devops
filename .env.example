# Copie para ".env" e ajuste se quiser. Todas as variaveis sao opcionais para rodar localmente.
# O arquivo .env esta no .gitignore: segredos nunca vao para o repositorio.
APP_PORT=8080
MONGO_USER=inovagab
MONGO_PASSWORD=inovagab-local
MONGO_DATABASE=inovagab
JWT_SECRET=inovagab-chave-local-de-desenvolvimento-com-tamanho-suficiente-256-bits
SEED_ENABLED=true
SEED_SENHA=123456
# Chave do Google Gemini (opcional). Sem ela, os endpoints de IA respondem 503 e o resto funciona.
GEMINI_API_KEY=
